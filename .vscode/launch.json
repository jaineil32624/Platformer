{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug game in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev server"
    },
    {
      "name": "Debug Electron main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": ["."],
      "preLaunchTask": "build"
    }
  ]
}
